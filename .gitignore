# Credentials and Secrets — never commit
*.env
*.env.*
.env
.env.*
*.key
*.pem
*.crt
credentials.json
secrets.yaml
secrets.yml

# Build / test artifacts
bin/
dist/
*.so
*.dylib
*.dll
*.exe
*.test
*.out
coverage/
coverage.out
*.prof

# Go workspace — dependencies resolve from published module versions, not a
# local workspace, so go.work never belongs in the repository
go.work
go.work.sum
gosec.sarif
trivy-results.sarif

# OS / editor
.DS_Store
*~
.idea/
.vscode/
*.swp
*.swo

# AI assistant / local tooling — never commit
.serena/*
# ...except the shared Serena project file (#140); caches and memories stay local
!.serena/project.yml
local.mk

# Agent instruction files (CLAUDE.md, AGENTS.md, .claude/) are tracked: the
# publish step strips them from the public tree (scaffold §7), and the
# releasability gate (build/ci/buildgates/releasability_test.go) reports them
# as strip-at-publish. Only the per-machine settings stay out of the index.
.claude/settings.local.json

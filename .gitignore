# Credentials and Secrets — never commit
*.env
*.env.*
.env
.env.*
*.key
*.pem
*.crt
credentials.json
secrets.yaml
secrets.yml

# Build / test artifacts
bin/
dist/
*.so
*.dylib
*.dll
*.exe
*.test
*.out
coverage/
coverage.out
*.prof

# Go workspace — dependencies resolve from published module versions, not a
# local workspace, so go.work never belongs in the repository
go.work
go.work.sum
gosec.sarif
trivy-results.sarif

# OS / editor
.DS_Store
*~
.idea/
.vscode/
*.swp
*.swo

# Agent and tool state: never commit. The releasability gate
# (build/ci/buildgates/releasability_test.go) refuses it if it is tracked.
.serena/
.claude/
scheduled_tasks.lock
lane-records/
*.log
local.mk

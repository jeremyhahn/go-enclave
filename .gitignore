# Credentials and Secrets — never commit
*.env
*.env.*
.env
.env.*
*.key
*.pem
*.crt
credentials.json
secrets.yaml
secrets.yml

# Build / test artifacts
bin/
dist/
*.so
*.dylib
*.dll
*.exe
*.test
*.out
coverage/
coverage.out
*.prof

# Go workspace — dependencies resolve from published module versions, not a
# local workspace, so go.work never belongs in the repository
go.work
go.work.sum
gosec.sarif
trivy-results.sarif

# OS / editor
.DS_Store
*~
.idea/
.vscode/
*.swp
*.swo

# AI assistant / local tooling — never commit
.serena/
.claude/
local.mk

# Agent instruction files. The public GitHub tree is byte-identical to the
# Gitea release tag (handbook version-control §5a), so anything tracked here is
# published; agent working notes are kept out of it (#80). The releasability
# gate (test/buildgates/releasability_test.go) fails if one is tracked anyway.
CLAUDE.md
AGENTS.md

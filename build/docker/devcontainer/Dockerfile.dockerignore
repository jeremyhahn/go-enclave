# Allowlist for the devcontainer build context: everything is excluded, then exactly what the stages read is re-admitted.
*
!go.mod
!go.sum
!build/ci/buildgates/go.mod
!build/ci/buildgates/go.sum
!backends/armtrustzone/go.mod
!backends/armtrustzone/go.sum
!backends/tpm/go.mod
!backends/tpm/go.sum
!scripts/lib.sh
!scripts/tool.sh
!scripts/tool-pins.sh
!scripts/install-tools.sh
!*.go
!backendtest/*.go
!providertest/*.go
!internal/**/*.go
!test/integration/**/*.go
!test/internal/**/*.go
!build/docker/devcontainer/run-integration-tests.sh
!scripts/coverage-gate.sh
# Root package tests stay admitted for the userns service; build/ci/buildgates pins this.
backendtest/*_test.go
providertest/*_test.go
internal/**/*_test.go
test/internal/**/*_test.go
!test/integration/**/*_test.go
